# Backend development target for the Vite /api proxy.
VITE_DEV_BACKEND_URL=http://localhost:8080

# Shared deployment schedule (service-availability-gate).
# Days are lowercase three-letter English names, comma separated.
# Times are 24-hour HH:MM in the configured IANA time zone.
VITE_OPEN_TZ=Europe/Berlin
VITE_OPEN_DAYS=mon,tue,wed,thu,fri
VITE_OPEN_FROM=08:00
VITE_OPEN_TO=22:00
