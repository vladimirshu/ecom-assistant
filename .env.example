# Copy this file to `.env` and fill in your OpenAI API key.
# Docker Compose reads `.env` from this directory automatically.
OPEN_AI_TOKEN=

# Optional: deployment schedule (also baked into the frontend build).
# If omitted, the defaults below are used.
VITE_OPEN_TZ=Europe/Berlin
VITE_OPEN_DAYS=mon,tue,wed,thu,fri
VITE_OPEN_FROM=08:00
VITE_OPEN_TO=22:00
