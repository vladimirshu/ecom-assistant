# Copy this file to `.env` and fill in your API keys.
# Docker Compose reads `.env` from this directory automatically.

# DeepSeek powers the chat model (query analysis + product selection).
DEEPSEEK_API_KEY=

# OpenAI is used only for embeddings (Qdrant vector search).
OPENAI_API_KEY=

# Qdrant connection. Leave all QDRANT_* variables unset to use the local
# Qdrant service started by docker-compose (plain gRPC on localhost:6334).
# To run the backend directly against Qdrant Cloud, export these settings:
# QDRANT_HOST=<cluster-id>.<region>.<provider>.cloud.qdrant.io
# QDRANT_PORT=6334
# QDRANT_USE_TLS=true
# QDRANT_API_KEY=<Qdrant Cloud database API key>
